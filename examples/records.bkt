// Records (with field punning) + tagged variants (real Option, no sentinels).

type Point = { x: Num, y: Num }
type OptNum = None | Some(Num)

@test point(2, 3) == { x: 2, y: 3 }
point(x: Num, y: Num) -> Point "construct a point" {
  { x, y }
}

@test mag2(point(3, 4)) == 25
mag2(p: Point) -> Num "squared magnitude" {
  p.x * p.x + p.y * p.y
}

@test unwrap_or(None, 7) == 7
@test unwrap_or(Some(9), 7) == 9
unwrap_or(o: OptNum, d: Num) -> Num "default if None" {
  match o {
    None => d,
    Some(v) => v
  }
}

@entry
main() -> Num "demo records + variants" {
  print(mag2(point(3, 4)))
  unwrap_or(Some(1), 0)
}
